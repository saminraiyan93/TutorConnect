@model BLL.Models.StudentRequestModel

@{
    ViewData["Title"] = "Edit Student Request";
}

<div class="container py-5">
    <div class="mb-4">
        <h1 class="fw-bold mb-2">Edit Student Request</h1>
        <p class="text-muted">Update the details of your tutoring request.</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form asp-controller="Post"
                  asp-action="UpdateMyStudentRequests"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="StudentRequestId" type="hidden" />
                <input asp-for="PostStatus" type="hidden" />

                <div asp-validation-summary="All"
                     class="alert alert-danger"
                     role="alert"></div>

                <div class="mb-3">
                    <label asp-for="PostTitle" class="form-label fw-semibold">
                        Post Title
                    </label>
                    <input asp-for="PostTitle" class="form-control" />
                    <span asp-validation-for="PostTitle" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label fw-semibold">
                        Course
                    </label>
                    <select asp-for="CourseId" class="form-select">
                        <option value="">-- Select a Course --</option>
                        @foreach (var course in ViewBag.Courses)
                        {
                            <option value="@course.CourseId">
                                @course.CourseName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CourseId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CoverageType" class="form-label fw-semibold">
                        Coverage
                    </label>
                    <select asp-for="CoverageType" class="form-select">
                        <option value="">-- Select Coverage --</option>
                        <option value="Full">Full Course</option>
                        <option value="Specific">Specific Topic</option>
                    </select>
                    <span asp-validation-for="CoverageType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TopicDescription" class="form-label fw-semibold">
                        Topics I Need Help With
                    </label>
                    <textarea asp-for="TopicDescription"
                              class="form-control"
                              rows="3"
                              placeholder="Select a coverage type first..."
                              required></textarea>
                    <span asp-validation-for="TopicDescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TeachingMode" class="form-label fw-semibold">
                        Teaching Mode
                    </label>
                    <select asp-for="TeachingMode" class="form-select">
                        <option value="Online">Online</option>
                        <option value="Offline">Offline</option>
                        <option value="Hybrid">Hybrid (Online &amp; Offline)</option>
                    </select>
                    <span asp-validation-for="TeachingMode" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BudgetType" class="form-label fw-semibold">
                        Budget
                    </label>
                    <select asp-for="BudgetType" class="form-select">
                        <option value="Paid">Paid</option>
                        <option value="Free">Free</option>
                    </select>
                    <span asp-validation-for="BudgetType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BudgetPerLecture" class="form-label fw-semibold">
                        Budget Per Lecture
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">BDT</span>
                        <input asp-for="BudgetPerLecture"
                               type="number"
                               min="0"
                               class="form-control" />
                        <span class="input-group-text">/ lecture</span>
                    </div>
                    <span asp-validation-for="BudgetPerLecture" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Availability" class="form-label fw-semibold">
                        Availability
                    </label>
                    <textarea asp-for="Availability"
                              class="form-control"
                              rows="3"></textarea>
                    <span asp-validation-for="Availability" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConnectVia" class="form-label fw-semibold">
                        Contact Method
                    </label>
                    <select asp-for="ConnectVia" class="form-select">
                        <option value="">-- Select Contact Method --</option>
                        <option value="Microsoft Teams">Microsoft Teams</option>
                        <option value="Facebook">Facebook</option>
                        <option value="WhatsApp">WhatsApp</option>
                        <option value="Phone">Phone</option>
                        <option value="Others">Other</option>
                    </select>
                    <span asp-validation-for="ConnectVia" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConnectValue" class="form-label fw-semibold">
                        Contact Information
                    </label>
                    <input asp-for="ConnectValue" class="form-control" />
                    <span asp-validation-for="ConnectValue" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Post"
                       asp-action="ManageStudentRequests"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const coverageType = document.getElementById("CoverageType");
        const topicDescription = document.getElementById("TopicDescription");
        const budgetType = document.getElementById("BudgetType");
        const budgetPerLecture = document.getElementById("BudgetPerLecture");

        function updateTopicDescription() {
            if (coverageType.value === "Full") {
                topicDescription.value = "Full Course";
                topicDescription.readOnly = true;
                topicDescription.placeholder = "";
            } else if (coverageType.value === "Specific") {
                if (topicDescription.value === "Full Course") {
                    topicDescription.value = "";
                }
                topicDescription.readOnly = false;
                topicDescription.placeholder = "Please specify the topics you need help with.";
            } else {
                topicDescription.value = "";
                topicDescription.readOnly = true;
                topicDescription.placeholder = "Select a coverage type first...";
            }
        }

        function updateBudgetPerLecture() {
            if (budgetType.value === "Free") {
                budgetPerLecture.value = "0";
                budgetPerLecture.readOnly = true;
            } else {
                budgetPerLecture.readOnly = false;
            }
        }

        coverageType.addEventListener("change", updateTopicDescription);
        budgetType.addEventListener("change", updateBudgetPerLecture);

        updateTopicDescription();
        updateBudgetPerLecture();
    });
</script>