@{
    ViewData["Title"] = "Manage Posts";
}

<div class="container py-5">
    <h1 class="mb-2">Manage Posts</h1>
    <p class="text-muted mb-4">View and manage the courses you’re offering to teach or courses you’re looking for help with.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <a asp-controller="Post"
               asp-action="ManageTutorOffers"
               class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 card-title">Manage Tutor Offers</h2>
                    <p class="card-text text-muted mb-0">
                        View, update, or delete your TutorOffer posts.
                    </p>
                </div>
            </a>
        </div>

        <div class="col-md-6">
            <a asp-controller="Post"
               asp-action="ManageStudentRequests"
               class="card h-100 text-decoration-none shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 card-title">Manage Student Requests</h2>
                    <p class="card-text text-muted mb-0">
                        View, update, or delete your StudentRequest posts.
                    </p>
                </div>
            </a>
        </div>
    </div>
</div>