@model IEnumerable<BLL.Models.TutorOfferingInfoModel>

@{
    ViewData["Title"] = "Manage Tutor Offers";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Manage Tutor Offers</h1>
        <p class="text-muted mb-0">Review tutor offers posted by users.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="p-4 text-muted">No tutor offers were found.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Tutor</th>
                                <th scope="col">Post Title</th>
                                <th scope="col">Course</th>
                                <th scope="col">Department</th>
                                <th scope="col">Status</th>
                                <th scope="col">Posted</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model)
                            {
                                var statusClass = "bg-secondary text-white";
                                if (offer.PostStatus == "Active")
                                {
                                    statusClass = "bg-success text-white";
                                }
                                else if (offer.PostStatus == "Pending")
                                {
                                    statusClass = "bg-warning text-dark";
                                }
                                else if (offer.PostStatus == "Inactive")
                                {
                                    statusClass = "bg-danger text-white";
                                }

                                <tr>
                                    <td>@offer.UserName</td>
                                    <td class="fw-semibold">@offer.PostTitle</td>
                                    <td>@offer.CourseName</td>
                                    <td>@offer.DepartmentName</td>
                                    <td><span class="badge @statusClass">@offer.PostStatus</span></td>
                                    <td>@offer.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap justify-content-end gap-1">
                                            <a asp-controller="AdminPost"
                                               asp-action="TutorOfferDetails"
                                               asp-route-id="@offer.TutorOfferingId"
                                               asp-route-returnTo="AdminManageTutorOffers"
                                               class="btn btn-sm btn-outline-primary">
                                                View Details
                                            </a>
                                            <form asp-controller="AdminPost" asp-action="UpdateTutorOfferStatus" method="post" class="d-flex gap-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@offer.TutorOfferingId" />
                                                <select name="status" class="form-select form-select-sm" aria-label="Tutor offer status">
                                                    <option value="Pending" selected="@(offer.PostStatus == "Pending")">Pending</option>
                                                    <option value="Active" selected="@(offer.PostStatus == "Active")">Active</option>
                                                    <option value="Inactive" selected="@(offer.PostStatus == "Inactive")">Inactive</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
