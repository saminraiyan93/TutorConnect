@model AppLayerMVC.Models.Account.ProfileModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5" id="profilePage" data-edit-field="@ViewBag.EditField">

    <div class="mb-4">
        <h1 class="fw-bold">My Profile</h1>
        <p class="text-muted mb-0">View and update your account information.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            @Html.ValidationSummary()

            <form asp-controller="Account" asp-action="UpdateProfileName" method="post" class="mb-4">
                @Html.AntiForgeryToken()

                <div id="nameDisplay" class="row align-items-center">
                    <div class="col-md-9">
                        <div class="text-muted small mb-1">Name</div>
                        <div class="fw-semibold">@Model.UserName</div>
                    </div>
                    <div class="col-md-3 text-md-end mt-2 mt-md-0">
                        <button type="button" data-edit="name" class="btn btn-outline-primary">Edit Name</button>
                    </div>
                </div>

                <div id="nameEditor" hidden>
                    <label class="form-label" for="UserName">Name</label>
                    @Html.TextBox("UserName", Model.UserName, new { @class = "form-control", maxlength = "50" })
                    <span class="text-danger">@Html.ValidationMessage("UserName")</span>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">Save Name</button>
                        <button type="button" data-cancel="name" class="btn btn-outline-secondary">Cancel</button>
                    </div>
                </div>
            </form>

            <hr />

            <form asp-controller="Account" asp-action="UpdateProfileEmail" method="post" class="my-4">
                @Html.AntiForgeryToken()

                <div id="emailDisplay" class="row align-items-center">
                    <div class="col-md-9">
                        <div class="text-muted small mb-1">Email</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                    <div class="col-md-3 text-md-end mt-2 mt-md-0">
                        <button type="button" data-edit="email" class="btn btn-outline-primary">Edit Email</button>
                    </div>
                </div>

                <div id="emailEditor" hidden>
                    <label class="form-label" for="Email">Email</label>
                    @Html.TextBox("Email", Model.Email, new { @class = "form-control", type = "email", maxlength = "50" })
                    <span class="text-danger">@Html.ValidationMessage("Email")</span>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">Save Email</button>
                        <button type="button" data-cancel="email" class="btn btn-outline-secondary">Cancel</button>
                    </div>
                </div>
            </form>

            <hr />

            <form asp-controller="Account" asp-action="UpdateProfilePassword" method="post" class="my-4">
                @Html.AntiForgeryToken()

                <div id="passwordDisplay" class="row align-items-center">
                    <div class="col-md-9">
                        <div class="text-muted small mb-1">Password</div>
                        <div class="fw-semibold">Not displayed</div>
                    </div>
                    <div class="col-md-3 text-md-end mt-2 mt-md-0">
                        <button type="button" data-edit="password" class="btn btn-outline-primary">Change Password</button>
                    </div>
                </div>

                <div id="passwordEditor" hidden>
                    <div class="mb-3">
                        <label class="form-label" for="Password">New Password</label>
                        <input type="password" name="Password" id="Password" class="form-control" />
                        <span class="text-danger">@Html.ValidationMessage("Password")</span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="ConfirmPassword">Confirm New Password</label>
                        <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="form-control" />
                        <span class="text-danger">@Html.ValidationMessage("ConfirmPassword")</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Password</button>
                        <button type="button" data-cancel="password" class="btn btn-outline-secondary">Cancel</button>
                    </div>
                </div>
            </form>

            <hr />

            <div>
                <div class="text-muted small mb-1">Account Status</div>
                <div class="fw-semibold">@Model.AccountStatus</div>
            </div>

        </div>

<script>
    function showProfileEditor(field) {
        document.getElementById(field + "Display").hidden = true;
        document.getElementById(field + "Editor").hidden = false;
    }

    function hideProfileEditor(field) {
        document.getElementById(field + "Editor").closest("form").reset();
        document.getElementById(field + "Editor").hidden = true;
        document.getElementById(field + "Display").hidden = false;
    }

    document.querySelectorAll("[data-edit]").forEach(function (button) {
        button.addEventListener("click", function () {
            showProfileEditor(button.dataset.edit);
        });
    });

    document.querySelectorAll("[data-cancel]").forEach(function (button) {
        button.addEventListener("click", function () {
            hideProfileEditor(button.dataset.cancel);
        });
    });

    var editField = document.getElementById("profilePage").dataset.editField;
    if (editField) {
        showProfileEditor(editField);
    }
</script>
    </div>

</div>
