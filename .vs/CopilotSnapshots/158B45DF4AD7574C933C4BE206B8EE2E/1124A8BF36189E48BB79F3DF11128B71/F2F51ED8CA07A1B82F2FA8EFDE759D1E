using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using BLL.Service;

namespace AppLayerMVC.Controllers;

[Authorize(Roles = "Admin")]
public class AdminPostController : Controller
{
    private readonly TutorOfferingService tutorOfferingService;
    private readonly StudentRequestService studentRequestService;

    public AdminPostController(TutorOfferingService tutorOfferingService, StudentRequestService studentRequestService)
    {
        this.tutorOfferingService = tutorOfferingService;
        this.studentRequestService = studentRequestService;
    }

    public IActionResult Index()
    {
        return View();
    }

    [HttpGet]
    public IActionResult AdminManageTutorOffers()
    {
        var offers = tutorOfferingService.GetAllTutorOfferingsWithInfo();
        return View(offers);
    }

    [HttpGet]
    public IActionResult AdminManageStudentRequests()
    {
        var requests = studentRequestService.GetAllStudentRequestsWithInfo();
        return View(requests);
    }
}
