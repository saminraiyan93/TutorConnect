@model List<BLL.Models.UserModel>

@{
    ViewData["Title"] = "Manage Users";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Manage Users</h1>
            <p class="text-muted mb-0">View registered TutorConnect accounts.</p>
        </div>

        <span class="badge text-bg-primary fs-6 mt-3 mt-md-0">
            Total users: @Model.Count
        </span>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="p-4 text-muted">
                    No users were found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">Username</th>
                                <th scope="col">Email</th>
                                <th scope="col">Role</th>
                                <th scope="col">Account Status</th>
                                <th scope="col">Created</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var statusClass = user.AccountStatus?.ToLowerInvariant() switch
                                {
                                    "active" => "text-bg-success",
                                    "suspended" => "text-bg-warning",
                                    "disabled" => "text-bg-secondary",
                                    _ => "text-bg-light"
                                };

                                <tr>
                                    <td>@user.UserId</td>
                                    <td class="fw-semibold">@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td>@user.Role</td>
                                    <td>
                                        <span class="badge @statusClass">
                                            @user.AccountStatus
                                        </span>
                                    </td>
                                    <td>
                                        @(user.CreatedAt?.ToString("yyyy-MM-dd") ?? "N/A")
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="AdminUser"
                                           asp-action="Details"
                                           asp-route-id="@user.UserId"
                                           class="btn btn-sm btn-outline-primary">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
