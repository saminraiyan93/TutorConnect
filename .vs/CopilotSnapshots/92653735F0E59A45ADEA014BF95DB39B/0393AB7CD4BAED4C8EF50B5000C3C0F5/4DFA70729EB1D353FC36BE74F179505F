@{
    ViewData["Title"] = "Manage Tutor Offers";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Manage Tutor Offers</h1>
        <p class="text-muted mb-0">
            Manage the courses you offer to teach.
        </p>
    </div>

    <!-- Tutor Offer Card -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">

            <!-- Title and Status -->
            <div class="d-flex justify-content-between
                        align-items-start gap-3 mb-4">

                <div>
                    <h2 class="h5 fw-semibold mb-1">
                        Experienced Calculus Tutor
                    </h2>

                    <div class="text-muted small">
                        Calculus I
                    </div>
                </div>

                <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                    Active
                </span>

            </div>

            <!-- Post Information -->
            <div class="row g-3 mb-4">

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Posted On
                        </div>
                        <div class="fw-medium">
                            Oct 10, 2026
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Course Coverage
                        </div>
                        <div class="fw-medium">
                            Full Course
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Teaching Mode
                        </div>
                        <div class="fw-medium">
                            Online
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Pricing
                        </div>
                        <div class="fw-semibold text-primary">
                            ৳800 / lecture
                        </div>
                    </div>
                </div>

            </div>

            <!-- Actions -->
            <div class="d-flex flex-wrap gap-2 pt-3 border-top">

                <a href="#"
                   class="btn btn-primary btn-sm">
                    <i class="bi bi-eye me-1"></i> View Details
                </a>

                <a href="#"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit Offer
                </a>

                <button type="button"
                        class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>

            </div>

        </div>
    </div>

    <!-- Example: Free Tutor Offer -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between
                        align-items-start gap-3 mb-4">

                <div>
                    <h2 class="h5 fw-semibold mb-1">
                        Introduction to Programming Tutor
                    </h2>

                    <div class="text-muted small">
                        Programming Fundamentals
                    </div>
                </div>

                <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                    Closed
                </span>

            </div>

            <div class="row g-3 mb-4">

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Posted On
                        </div>
                        <div class="fw-medium">
                            Oct 8, 2026
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Course Coverage
                        </div>
                        <div class="fw-medium">
                            Specific Topics
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Teaching Mode
                        </div>
                        <div class="fw-medium">
                            In Person
                        </div>
                    </div>
                </div>

                <div class="col-6 col-lg-4">
                    <div class="bg-light rounded-3 p-3 h-100">
                        <div class="small text-muted mb-1">
                            Pricing
                        </div>
                        <div class="fw-semibold text-success">
                            Free
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap gap-2 pt-3 border-top">

                <a href="#"
                   class="btn btn-primary btn-sm">
                    <i class="bi bi-eye me-1"></i> View Details
                </a>

                <a href="#"
                   class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-pencil me-1"></i> Edit Offer
                </a>

                <button type="button"
                        class="btn btn-outline-success btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reopen Offer
                </button>

                <button type="button"
                        class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>

            </div>

        </div>
    </div>

</div>

