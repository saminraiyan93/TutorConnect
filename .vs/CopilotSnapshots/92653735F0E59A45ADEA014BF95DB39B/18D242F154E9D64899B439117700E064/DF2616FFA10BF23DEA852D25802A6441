@model AppLayerMVC.Models.Account.EditProfileNameModel

@{
    ViewData["Title"] = "Edit Name";
}

<div class="container py-5">

    <div class="mb-4">
        <h1 class="fw-bold">Edit Name</h1>
        <p class="text-muted mb-0">Update the name associated with your account.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            @Html.ValidationSummary()

            <form asp-controller="Account" asp-action="UpdateProfileName" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="UserName" class="form-label">Name</label>
                    <input asp-for="UserName" class="form-control" placeholder="Enter your name" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>

</div>
