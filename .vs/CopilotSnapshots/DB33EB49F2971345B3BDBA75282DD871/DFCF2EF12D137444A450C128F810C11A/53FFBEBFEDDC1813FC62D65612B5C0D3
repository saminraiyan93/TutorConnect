@model BLL.Models.UserModel

@{
    ViewData["Title"] = "User Details";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">User Details</h1>
            <p class="text-muted mb-0">Review this TutorConnect account.</p>
        </div>

        <a asp-controller="AdminUser"
           asp-action="Index"
           class="btn btn-outline-primary">
            Back to Users
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">User ID</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Username</dt>
                <dd class="col-sm-9">@Model.UserName</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@Model.Role</dd>

                <dt class="col-sm-3">Account Status</dt>
                <dd class="col-sm-9">@Model.AccountStatus</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>

                <dt class="col-sm-3">Updated At</dt>
                <dd class="col-sm-9">@(Model.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</dd>
            </dl>

            <hr class="my-4" />

            <h5 class="fw-bold">Update Account Status</h5>

            <form asp-controller="AdminUser"
                  asp-action="UpdateStatus"
                  method="post"
                  class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.UserId" />

                <div class="col-md-5">
                    <label for="accountStatus" class="form-label">Account status</label>
                    <select id="accountStatus" name="accountStatus" class="form-select">
                        <option value="Active" selected="@(Model.AccountStatus == "Active")">Active</option>
                        <option value="Suspended" selected="@(Model.AccountStatus == "Suspended")">Suspended</option>
                        <option value="Disabled" selected="@(Model.AccountStatus == "Disabled")">Disabled</option>
                    </select>
                </div>

                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">
                        Update Status
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>