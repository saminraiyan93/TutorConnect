using DAL.EF;
using System.Linq;

namespace DAL.Repository;

/// <summary>
/// Provides database queries for aggregate metrics displayed on the admin dashboard.
/// </summary>
public class AdminDashboardRepo
{
    private readonly TutorConnectContext db;

    public AdminDashboardRepo(TutorConnectContext db)
    {
        this.db = db;
    }

    public int GetTotalUsers()
    {
        return db.Users.Count();
    }

    public int GetActiveTutorOffers()
    {
        return db.TutorOfferings.Count(t => t.PostStatus == "Active");
    }

    public int GetActiveStudentRequests()
    {
        return db.StudentRequests.Count(r => r.PostStatus == "Active");
    }
}
